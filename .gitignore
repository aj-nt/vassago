# Build output
bin/
*.out
coverage.out

# Binaries (in case built at project root)
/mnemosyne
/mnemosyne-agent
/mnemosyne-cli
/mnemosyne-daemon
/mnemosyne-import

# OS files
.DS_Store

# Database files (local dev only)
*.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Generated proto (re-run protoc to regenerate)
# proto/ files ARE tracked — generated Go files match the .proto source

# Generated Python gRPC stubs (run make proto-python to regenerate)
proto/*_pb2.py
proto/*_pb2_grpc.py
proto/*_pb2.pyi